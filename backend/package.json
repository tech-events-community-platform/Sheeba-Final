
services:
  backend:
    build:
      context: ./backend
      dockerfile: Dockerfile
    restart: unless-stopped
    env_file:
      - ./.env
    expose:
      - "5000"
    networks:
      - sheeba-network

  frontend:
    build:
      context: ./frontend
      dockerfile: Dockerfile
      args:
        VITE_API_URL: https://api-staging.sheebanet.com/api
        VITE_GOOGLE_CLIENT_ID: 415994350759-tfifv80t1u3efof3m136g0i0d9nkg4p6.apps.googleusercontent.com
        VITE_CLOUDINARY_CLOUD_NAME: dktpwqspb
        VITE_CLOUDINARY_UPLOAD_PRESET: ml_default
    restart: unless-stopped
    expose:
      - "80"
    depends_on:
      - backend
    networks:
      - sheeba-network

networks:
  sheeba-network:
    driver: bridge
