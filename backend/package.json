{
  "name": "sheba-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc && copyfiles -u 2 src/db/schema.sql dist/db",
    "start": "node dist/server.js",
    "db:migrate": "ts-node src/db/migrate.ts",
    "db:seed": "ts-node src/db/seed.ts",
    "test": "ts-node src/tests/test_security_remediation.ts && ts-node src/tests/test_background_email_delivery.ts && ts-node src/tests/test_random_password_and_manual_registration.ts && ts-node src/tests/test_redis_caching_and_isolation.ts",
    "test:all": "ts-node src/tests/test_security_remediation.ts && ts-node src/tests/test_background_email_delivery.ts && ts-node src/tests/test_random_password_and_manual_registration.ts && ts-node src/tests/test_redis_caching_and_isolation.ts",
    "test:cache": "ts-node src/tests/test_redis_caching_and_isolation.ts",
    "test:verify-redis": "ts-node src/tests/test_redis_multi_instance_verification.ts",
    "test:upstash": "ts-node src/tests/test_upstash_live_verification.ts",
    "test:security": "ts-node src/tests/test_security_remediation.ts",
    "test:background-email": "ts-node src/tests/test_background_email_delivery.ts",
    "test:credentials": "ts-node src/tests/test_random_password_and_manual_registration.ts",
    "test:payment": "ts-node src/tests/test_payment_integration.ts",
    "test:manual-reg": "ts-node src/tests/test_enhanced_manual_registration.ts",
    "test:exhibitors": "ts-node src/tests/test_exhibitor_receipt_workflow.ts",
    "test:organizer": "ts-node src/tests/test_organizer_flow_stabilization.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "google-auth-library": "^11.0.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "copyfiles": "^2.4.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
