# Root .gitignore for Sheeba Event Platform

# Environment variables (strictly ignored across all subdirectories)
.env
.env.*
*.env
*.env.*
frontend/.env
frontend/.env.*
backend/.env
backend/.env.*
!.env.example
!*.env.example
!frontend/.env.example
!backend/.env.example
!backend/src/.env.example

# Dependencies
node_modules/
frontend/node_modules/
backend/node_modules/

# Production builds
dist/
frontend/dist/
backend/dist/
dist-ssr/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS files
.vscode/
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
